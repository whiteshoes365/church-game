{
  "name": "church-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "add-week": "node scripts/add-week.mjs",
    "build": "npm install --include=dev && npm run build -w client",
    "verify": "node verify/verify.mjs",
    "start": "node server/src/index.js",
    "verify:remote": "node verify/verify.mjs",
    "gen-gemini": "node scripts/gen-questions-gemini.mjs",
    "verify:supabase": "node scripts/verify-supabase-records.mjs"
  },
  "devDependencies": {
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  }
}
