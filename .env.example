# Copy to a local .env (never commit the real file).
# Records / reports use Supabase only when both are set; otherwise local JSON under RECORDS_DIR.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password for the question review page (/#/review). Checked on the server only.
# Leave empty to keep review login and actions disabled. Do not put this in VITE_* or the client.
QUESTION_REVIEW_PASSWORD=
